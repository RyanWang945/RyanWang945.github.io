---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li class="flex">
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "border-border bg-muted/35 inline-flex items-center gap-1 rounded-lg border font-medium no-underline transition-colors duration-200",
      "hover:border-accent hover:bg-accent/10 hover:text-accent",
      "focus-visible:border-accent focus-visible:text-accent",
      { "px-2.5 py-1.5 text-sm": size === "sm" },
      { "px-3 py-2 text-base": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-70",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {tagName}
  </a>
</li>
